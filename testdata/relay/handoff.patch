diff --git a/src/workflows/handoff.ts b/src/workflows/handoff.ts
new file mode 100644
index 0000000..34b08cf
--- /dev/null
+++ b/src/workflows/handoff.ts
@@ -0,0 +1,77 @@
+// The handoff to plugin-temporal (https://github.com/spec-studio-app/plugin-temporal,
+// HANDOFF.md). An open relay workflow continues as new into the plugin's
+// workflow type, with the same workflow ID and task queue, and passes its
+// state as the plugin's documents. The plugin knows no relay rule: the
+// documents and their attributes come from here, as the relay's protocol
+// adapter writes them (PROTOCOL.md section 14 in spec-studio-app/plugin-sdk).
+//
+// This file runs in the workflow sandbox: keep it free of Node APIs.
+import { defineUpdate, makeContinueAsNewFunc } from "@temporalio/workflow";
+import type { Bound } from "./bound.js";
+import type { DeskState, RelayConfigState, SpecWorkflowState } from "./types.js";
+import { specMemo } from "./specRules.js";
+import { deskMemo } from "./deskRules.js";
+
+/** The plugin's workflow type. */
+export const PLUGIN_WORKFLOW_TYPE = "SpecStudioEntity";
+
+export type Attributes = Record<string, string | number | boolean | null>;
+
+export interface HandoffDoc {
+  collection: string;
+  key: string;
+  value: unknown;
+  attributes: Attributes;
+}
+
+export interface HandoffInput {
+  handoff: { version: 1; workflowId: string; documents: HandoffDoc[] };
+}
+
+/** Ask an open relay workflow to continue as new into the plugin. */
+export const handoffUpdate = defineUpdate<void, [Bound]>("handoff");
+
+export function specDocuments(s: SpecWorkflowState): HandoffDoc[] {
+  const memo = specMemo(s);
+  return [
+    {
+      collection: "specs",
+      key: `${s.spec.repoKey}:${s.spec.slug}`,
+      value: s,
+      attributes: {
+        repoKey: s.spec.repoKey,
+        open: memo.stage !== "merged",
+        pendingForMac: memo.waitingForMac > 0,
+        pendingForCoordinator: memo.unreadForCoordinator > 0,
+        deployId: s.deployId,
+      },
+    },
+  ];
+}
+
+export function deskDocuments(s: DeskState): HandoffDoc[] {
+  const memo = deskMemo(s);
+  return [
+    {
+      collection: "desks",
+      key: s.desk.repoKey,
+      value: s,
+      attributes: {
+        repoKey: s.desk.repoKey,
+        pendingForMac: memo.waitingForMac > 0,
+        pendingForCoordinator: memo.unreadForCoordinator > 0,
+        deployId: s.deployId,
+      },
+    },
+  ];
+}
+
+export function configDocuments(s: RelayConfigState): HandoffDoc[] {
+  return [{ collection: "relay", key: "config", value: s, attributes: {} }];
+}
+
+/** Continue as new into the plugin's workflow. It never returns. */
+export async function continueIntoPlugin(workflowId: string, documents: HandoffDoc[]): Promise<never> {
+  const toPlugin = makeContinueAsNewFunc<(input: HandoffInput) => Promise<void>>({ workflowType: PLUGIN_WORKFLOW_TYPE });
+  return toPlugin({ handoff: { version: 1, workflowId, documents } });
+}
